# Copie ce fichier en .env et remplis les valeurs. NE COMMITE JAMAIS .env.

# Endpoint de ton instance ComfyUI (RunComfy / RunPod / locale).
# - RunComfy machine interactive : URL fournie par RunComfy
# - Local : http://127.0.0.1:8188
COMFYUI_URL=https://ton-endpoint-runcomfy

# Clé API (RunComfy serverless / Comfy Cloud). Laisse vide en local.
COMFYUI_API_KEY=

# Pour les endpoints serverless RunComfy (déploiement en API) :
RUNCOMFY_DEPLOYMENT_ID=
RUNCOMFY_API_TOKEN=
